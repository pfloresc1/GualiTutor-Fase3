<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF"
    tools:context=".LeccionesActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis lecciones"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una lección para comenzar"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnLeccion1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lección 1"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4" />

        <Button
            android:id="@+id/btnLeccion2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lección 2"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnLeccion3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lección 3"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnVolverInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#757575"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
