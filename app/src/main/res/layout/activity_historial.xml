<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF"
    tools:context=".HistorialActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi historial"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consulta tu progreso de aprendizaje"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtHistorial1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lección 1: Pendiente"
            android:textSize="16sp"
            android:textColor="#263238"
            android:background="#EDE7F6"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtHistorial2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lección 2: Pendiente"
            android:textSize="16sp"
            android:textColor="#263238"
            android:background="#EDE7F6"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtHistorial3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lección 3: Pendiente"
            android:textSize="16sp"
            android:textColor="#263238"
            android:background="#EDE7F6"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVolverHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:backgroundTint="#757575" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
